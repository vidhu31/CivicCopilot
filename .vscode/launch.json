{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run FastAPI Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host", "127.0.0.1",
                "--port", "8000"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}",
            "env": {},
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Application startup complete",
                "uriFormat": "http://127.0.0.1:8000/chat",
                "action": "openExternally"
            }
        }
    ]
}